#include <stdio.h>
#include <stdlib.h>

int main(){

  int n;
  long l;
  char c;
  float f;
  double d;
  int* p = &n;

  printf("The size of an int is: %d\n",sizeof(n));
  printf("The size of a long is: %d\n",sizeof(l));
  printf("The size of a char is: %d\n",sizeof(c));
  printf("The size of a float is: %d\n",sizeof(f));
  printf("The size of a double is: %d\n",sizeof(d));
  printf("The size of a pointer is: %d\n",sizeof(p));
  
  return 0;
}
